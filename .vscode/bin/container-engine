#!/usr/bin/env bash
# Wrapper that picks Docker or Podman at invocation time and forwards all
# arguments to it. Lets "dev.containers.dockerPath" point at one stable,
# committed path instead of a value that differs per machine/engine.
set -euo pipefail

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    exec docker "$@"
elif command -v podman-remote >/dev/null 2>&1 && podman-remote info >/dev/null 2>&1; then
    exec podman-remote "$@"
elif command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
    exec podman "$@"
else
    echo "Error: no working Docker or Podman found." >&2
    exit 1
fi
