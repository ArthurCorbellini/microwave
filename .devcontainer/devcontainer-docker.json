{
  "name": "microwave",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8081, 8082, 8083],

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack"
      ]
    }
  },

  // Standard "Docker-outside-of-Docker" pattern: bind-mount the host's
  // Docker socket into the dev container so Testcontainers (used by the
  // integration tests) can reach it. Docker's client already looks at
  // /var/run/docker.sock by default, so no DOCKER_HOST override is needed
  // here, and real Docker doesn't have Podman's Ryuk/network-naming issue.
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ]
}
